# SED2 demo parameter file
# Edit as needed

# Galaxy name (e.g., NGC0628)

# Pipeline steps to run: bkg, crop, psf, mask, fluxmap, binning, fit
steps           bkg, crop, psf, mask, fluxmap, binning

# Detection band for galaxy region identification
detect_band     sdss_r
# Detection nsigma threshold
detect_nsigma   1.0

# Crop size in pixels
crop_size       151

# SNR threshold for pixel binning
snr_thresh      3.0

# Minimum pixels per bin
npix_min        30

# Reference band for PSF matching (target resolution)
psf_ref         spitzer_mips_24

# Fitting mode: highres or full
fit_mode        highres

# Number of parallel processes for fitting
n_process       60

# Output directory (relative to project root)
out_dir         data

# Redshift (set to 0 for catalog value)
redshift        0.0

# Verbose output
verbose         True
